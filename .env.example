# --- Supabase (patient PWA + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telegram bot (Edge Function) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# A random string you choose; Telegram echoes it back on each webhook call.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# --- Request routing config ---
SEARCH_RADIUS_KM=2
REQUEST_TTL_MINUTES=20
DEFAULT_DISTRICT=Maadi
# Max patient requests per IP per 5 minutes (anti ping-spam).
REQUEST_RATE_LIMIT=5

# --- Ops dashboard (Phase 4) ---
# Single shared password to view the fill-rate dashboard.
DASHBOARD_PASSWORD=change-me

# --- Cron (request expiry) ---
# Required for the /api/cron/expire route. Vercel Cron sends this as a Bearer
# token automatically. Leave unset only for local dev.
CRON_SECRET=change-me-to-a-random-string
